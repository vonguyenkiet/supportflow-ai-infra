{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportFlowReleaseManifest",
  "type": "object",
  "required": [
    "releaseId",
    "version",
    "createdAt",
    "status",
    "components",
    "thirdPartyDependencies",
    "databaseMigration"
  ],
  "properties": {
    "releaseId": { "type": "string" },
    "version": { "type": "string" },
    "previousReleaseId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["prepared", "verified", "rejected"]
    },
    "components": {
      "type": "object",
      "required": ["backend", "web", "aiService", "infrastructure"],
      "properties": {
        "backend": {
          "type": "object",
          "required": [
            "repository",
            "branch",
            "baselineCommit",
            "buildCommit",
            "workflowRunId",
            "workflowRunUrl",
            "artifacts"
          ],
          "properties": {
            "repository": { "type": "string" },
            "branch": { "type": "string" },
            "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "buildCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "workflowRunId": { "type": ["integer", "string"] },
            "workflowRunUrl": { "type": "string" },
            "artifacts": {
              "type": "object",
              "required": ["api", "worker", "database"],
              "additionalProperties": {
                "type": "object",
                "required": ["image", "tag", "digest", "publicationStatus", "description"],
                "properties": {
                  "image": { "type": "string" },
                  "tag": { "type": "string" },
                  "digest": { "type": ["string", "null"] },
                  "publicationStatus": { "type": "string", "enum": ["published", "pending", "blocked"] },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "web": {
          "type": "object",
          "required": [
            "repository",
            "branch",
            "baselineCommit",
            "buildCommit",
            "workflowRunId",
            "workflowRunUrl",
            "artifacts"
          ],
          "properties": {
            "repository": { "type": "string" },
            "branch": { "type": "string" },
            "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "buildCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "workflowRunId": { "type": ["integer", "string"] },
            "workflowRunUrl": { "type": "string" },
            "artifacts": {
              "type": "object",
              "required": ["web"],
              "additionalProperties": {
                "type": "object",
                "required": ["image", "tag", "digest", "publicationStatus", "description"],
                "properties": {
                  "image": { "type": "string" },
                  "tag": { "type": "string" },
                  "digest": { "type": ["string", "null"] },
                  "publicationStatus": { "type": "string", "enum": ["published", "pending", "blocked"] },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "aiService": {
          "type": "object",
          "required": [
            "repository",
            "branch",
            "baselineCommit",
            "buildCommit",
            "workflowRunId",
            "workflowRunUrl",
            "artifacts"
          ],
          "properties": {
            "repository": { "type": "string" },
            "branch": { "type": "string" },
            "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "buildCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "workflowRunId": { "type": ["integer", "string"] },
            "workflowRunUrl": { "type": "string" },
            "artifacts": {
              "type": "object",
              "required": ["aiService"],
              "additionalProperties": {
                "type": "object",
                "required": ["image", "tag", "digest", "publicationStatus", "description"],
                "properties": {
                  "image": { "type": "string" },
                  "tag": { "type": "string" },
                  "digest": { "type": ["string", "null"] },
                  "publicationStatus": { "type": "string", "enum": ["published", "pending", "blocked"] },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "infrastructure": {
          "type": "object",
          "required": [
            "repository",
            "branch",
            "baselineCommit",
            "buildCommit",
            "workflowRunId",
            "workflowRunUrl",
            "artifacts"
          ],
          "properties": {
            "repository": { "type": "string" },
            "branch": { "type": "string" },
            "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "buildCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "workflowRunId": { "type": ["integer", "string"] },
            "workflowRunUrl": { "type": "string" },
            "artifacts": {
              "type": "object",
              "required": ["minio"],
              "additionalProperties": {
                "type": "object",
                "required": ["image", "tag", "digest", "publicationStatus", "description"],
                "properties": {
                  "image": { "type": "string" },
                  "tag": { "type": "string" },
                  "digest": { "type": ["string", "null"] },
                  "publicationStatus": { "type": "string", "enum": ["published", "pending", "blocked"] },
                  "description": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "thirdPartyDependencies": {
      "type": "object",
      "required": ["postgres", "nginx"],
      "properties": {
        "postgres": { "type": "string" },
        "nginx": { "type": "string" }
      }
    },
    "databaseMigration": {
      "type": "object",
      "required": ["currentMigration", "toolPurpose"],
      "properties": {
        "currentMigration": { "type": "string" },
        "toolPurpose": { "type": "string" }
      }
    }
  }
}
